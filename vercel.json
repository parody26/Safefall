{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.py?__path=/api/v1/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path=/health"
    },
    {
      "source": "/monitor",
      "destination": "/public/monitor.html"
    },
    {
      "source": "/family",
      "destination": "/public/family.html"
    },
    {
      "source": "/",
      "destination": "/public/family.html"
    }
  ]
}
