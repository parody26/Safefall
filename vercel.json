{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/monitor",
      "destination": "/public/monitor.html"
    },
    {
      "source": "/family",
      "destination": "/public/family.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
