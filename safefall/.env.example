# SafeFall Environment Configuration Example
# Copy to .env for production credentials

# Backend & Cloud API
SAFEFALL_API_BASE_URL=http://localhost:8080/api/v1
SAFEFALL_DEVICE_API_KEY=dev_token_sample_123

# Firebase Client Configuration (Mobile & Desktop)
FIREBASE_PROJECT_ID=safefall-app
FIREBASE_API_KEY=AIzaSyA_sample_firebase_client_key
FIREBASE_AUTH_DOMAIN=safefall-app.firebaseapp.com
FIREBASE_STORAGE_BUCKET=safefall-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Emergency Escalation & Telephony
EMERGENCY_DEFAULT_NUMBER=112
SUSPECTED_FALL_GRACE_SEC=3.0
VOICE_RESPONSE_TIMEOUT_SEC=10.0
